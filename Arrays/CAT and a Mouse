class Solution{
   public static String catMouse(int x,int y,int z){
      int distanceA = Math.abs(x - z);
      int distanceB = Math.abs(y - z);
      if(distanceA < distanceB){
         return "Cat A";
      }
      else if(distanceA < distanceB){
         return "Cat A";
      }
      else{ 
          return "Mouse C";
        }
   }
}

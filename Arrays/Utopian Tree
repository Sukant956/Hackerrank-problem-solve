// Problem: Utopian Tree
// Platform: Hackerrank
// Approach: For Loop 
// Time Complexity: O(n)
// Space Complexity: O(n)

// Code

class Solution{
  public static int Utopian Tree(int n){
    int value = 1;
    for(int i = 1;i <= n;i++){
       if(i % 2 == 0){
        value += 1;
       }
       else{
         value *= 2;
       }
    }
    return value;
  }
}

// Problem: Camel Case
// Platform: Hackerrank
// Approach: Using for loop
// Time Complexity: O(n)
// Space Complexity:O(n)

// Code

class Solution{
   public static int camelCase(String s){
     int count = -1;
    for(int i = 0;i < s.length();i++){
       char ch = s.charAt(i);
       if(character.isUpperCase(ch)){
          count++;
       }
    }
    return count;
   }
}

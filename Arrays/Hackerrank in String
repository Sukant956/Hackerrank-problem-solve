// Problem: Hackerrank in String
// Platform: Hackerrank
// Approach:
// Time Complexity:
// Space Complexity:

// Code

class Solution{
  public static String hackerrankInString(String s){
     String target = "hackerrank";
     int j = 0;
     for(int i =0;i < s.length();i++){
         if(s.charAt(i) == target.charAt(j)){
            j++;
         }
        if(j == target.length()){
           return "Yes";
        }
     }
    return "NO";
  }
}

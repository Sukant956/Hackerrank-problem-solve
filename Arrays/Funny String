// Space Complexity:

// Code
class Solution{
   static string funnyString(String s){
      StringBuilder rev = new StringBuilder(s);
      rev.reverse();
      for(int i = 0; i < s.length() - 1;i++){
         int a = Mth.abs((int)(s.charAt(i))- (int)(s.charAt(i+1)));
         int b = Mth.abs((int)(rev.charAt(i))- (int)(rev.charAt(i+1)));
       
      }
      if(a != b){
        return "Not Funny";
      }
   }
  return "Funny";
}

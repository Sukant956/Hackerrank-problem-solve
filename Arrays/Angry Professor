// Problem: Angry Professor
// Platform: Hackerrank
// Approach: loop and conditional 
// Time Complexity: O(n)
// Space Complexity: O(n)

// Code

class Solution{
   public static string angryProfessor(int k,int arr[]){
      int onTime = 0;
      for(int i = 0;i < arr.length;i++){
          if(arr[i] <= 0){
             onTime++;
          }
      }
      if(onTime < k){
        return "Yes";
      }
      else{
        return "No";
      }
 
   }
}
